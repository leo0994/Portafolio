---
const base = import.meta.env.BASE_URL;

type Project = {
  titleKey: string;
  descriptionKey: string;
  tech: string[];
  images: string[];
  link: string | null;
  live: string | null;
  isPrivate: boolean;
  category: "cliente" | "propio";
  client?: string;
};

const projects: Project[] = [
  {
    titleKey: "fincaEsmeralda",
    descriptionKey: "finca_esmeralda_descripcion",
    tech: ["Astro", "Google Auth", "Cloudinary", "MVC"],
    images: [`${base}imagen/finca-esmeralda.jpg`],
    link: null,
    live: null,
    isPrivate: false,
    category: "cliente",
    client: "Hugo Barrantes",
  },
  {
    titleKey: "adrianPortillaTattoo",
    descriptionKey: "proyecto_adrian_tattoo_descripcion",
    tech: ["Astro", "Prisma ORM", "Cloudinary", "Google Auth"],
    images: [`${base}imagen/adrian-tatuajes.png`],
    link: null,
    live: null,
    isPrivate: false,
    category: "cliente",
    client: "Adrian Portilla - Tatuador",
  },
  {
    titleKey: "mentana",
    descriptionKey: "proyecto1_descripcion",
    tech: ["Spring Boot", "Angular"],
    images: [`${base}imagen/mentana.jpg`],
    link: null,
    live: null,
    isPrivate: false,
    category: "cliente",
    client: "Mentana - Centro Recreativo",
  },
  {
    titleKey: "gymSystem",
    descriptionKey: "gym_system_descripcion",
    tech: ["C#", ".NET", "SQL Server", "Azure SQL"],
    images: [`${base}imagen/gym-system-cover.svg`],
    link: null,
    live: null,
    isPrivate: true,
    category: "cliente",
  },
  {
    titleKey: "digimonApi",
    descriptionKey: "proyecto2_descripcion",
    tech: [".NET", "API"],
    images: [`${base}imagen/digimon-api.jpg`],
    link: null,
    live: null,
    isPrivate: true,
    category: "propio",
  },
  {
    titleKey: "proyecto3_titulo",
    descriptionKey: "proyecto3_descripcion",
    tech: ["React", "Tailwind CSS"],
    images: [
      `${base}imagen/tic-tac-toe-v3.jpg`,
      `${base}imagen/tic-tac-toe-v2.jpg`,
      `${base}imagen/tic-tac-toe-imagen-juego.jpg`,
    ],
    link: null,
    live: null,
    isPrivate: false,
    category: "propio",
  },
  {
    titleKey: "proyecto5_titulo",
    descriptionKey: "proyecto5_descripcion",
    tech: ["Spring Boot", "MVC"],
    images: [`${base}imagen/farmacia.jpg`],
    link: null,
    live: null,
    isPrivate: true,
    category: "propio",
  },
  {
    titleKey: "proyecto4_titulo",
    descriptionKey: "proyecto4_descripcion",
    tech: ["Ruby on Rails", "Bootstrap"],
    images: [`${base}imagen/rubi-proyecto.jpg`],
    link: null,
    live: null,
    isPrivate: false,
    category: "propio",
  },
];
---

<section
  id="proyectos"
  class="max-w-6xl mx-auto px-4 py-16"
  style="scroll-margin-top: 100px;"
>
  <!-- Título -->
  <div class="flex justify-center items-center mb-8 gap-4">
    <img
      src={`${base}icons/logo-plasma-celeste.png`}
      alt="Logo animado"
      class="w-12 h-12 animate-spin-slow hover:scale-110 transition duration-300"
    />
    <h2 class="text-4xl font-bold text-white text-center" data-i18n="mis_proyectos">
      Mis Proyectos
    </h2>
  </div>

  <!-- Filtro de categorías -->
  <div class="flex justify-center gap-2 mb-8" data-proyecto-filtros>
    <button
      type="button"
      data-filtro="all"
      aria-pressed="true"
      class="proyecto-filtro px-4 py-1.5 rounded-full border border-white/10 bg-white/10 text-white text-sm font-medium transition"
      data-i18n="proyectos_filtro_todos"
    >
      Todos
    </button>
    <button
      type="button"
      data-filtro="cliente"
      aria-pressed="false"
      class="proyecto-filtro px-4 py-1.5 rounded-full border border-white/10 bg-white/5 text-gray-300 text-sm font-medium hover:bg-white/10 transition"
      data-i18n="proyectos_filtro_cliente"
    >
      Con cliente
    </button>
    <button
      type="button"
      data-filtro="propio"
      aria-pressed="false"
      class="proyecto-filtro px-4 py-1.5 rounded-full border border-white/10 bg-white/5 text-gray-300 text-sm font-medium hover:bg-white/10 transition"
      data-i18n="proyectos_filtro_propio"
    >
      Propios
    </button>
  </div>

  <div class="grid md:grid-cols-[minmax(0,1fr)_280px] gap-6 items-start" data-proyectos-root>
    <!-- Panel: fotos + detalle del proyecto seleccionado -->
    <div
      class="rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm p-5 sm:p-6"
      data-proyecto-panel
    >
      <div data-proyecto-fotos class="mb-6 transition-opacity duration-200"></div>

      <div class="flex items-center gap-2 flex-wrap">
        <h3 class="text-2xl font-semibold text-white" data-proyecto-titulo></h3>
        <span
          data-proyecto-privado
          class="hidden text-[10px] font-bold uppercase tracking-wide px-2 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40"
          data-i18n="proyectoPrivado"
        >
          Proyecto Confidencial
        </span>
      </div>

      <p data-proyecto-cliente class="hidden text-xs text-[#2dbdff] font-medium mt-1"></p>
      <p class="text-gray-400 text-sm mt-2" data-proyecto-desc></p>

      <div class="flex flex-wrap gap-2 mt-4" data-proyecto-tech></div>

      <div class="flex items-center gap-x-6 mt-6 min-h-[1.75rem]">
        <a
          data-proyecto-link
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden text-[#2dbdff] hover:brightness-125 font-semibold"
        >
          🔗 <span data-i18n="codigoFuente">Código Fuente</span>
        </a>
        <a
          data-proyecto-live
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden text-green-400 hover:text-green-300 font-semibold"
        >
          🚀 <span data-i18n="demo">Demo en Vivo</span>
        </a>
      </div>
    </div>

    <!-- Lista seleccionable de proyectos -->
    <div
      class="flex flex-row md:flex-col gap-2 overflow-x-auto md:overflow-visible pb-2 md:pb-0"
      role="tablist"
      aria-label="Lista de proyectos"
      data-proyecto-lista
    >
      {projects.map((project, i) => (
        <button
          type="button"
          role="tab"
          data-index={i}
          data-categoria={project.category}
          aria-selected={i === 0 ? "true" : "false"}
          class="proyecto-tab shrink-0 md:shrink text-left px-4 py-3 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 transition whitespace-nowrap md:whitespace-normal"
        >
          <span class="block text-sm font-semibold text-white" data-i18n={project.titleKey}>
            {project.titleKey}
          </span>
          <span class="hidden md:block text-xs text-gray-400 mt-0.5">
            {project.client ?? project.tech[0]}
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .proyecto-tab[aria-selected="true"] {
    background-color: rgba(45, 189, 255, 0.15);
    border-color: rgba(45, 189, 255, 0.5);
  }
  .proyecto-filtro[aria-pressed="true"] {
    background-color: rgba(45, 189, 255, 0.2);
    border-color: rgba(45, 189, 255, 0.5);
    color: white;
  }
</style>

<script define:vars={{ projects }}>
  const panelFotos = document.querySelector("[data-proyecto-fotos]");
  const titulo = document.querySelector("[data-proyecto-titulo]");
  const privadoBadge = document.querySelector("[data-proyecto-privado]");
  const clienteLine = document.querySelector("[data-proyecto-cliente]");
  const desc = document.querySelector("[data-proyecto-desc]");
  const techWrap = document.querySelector("[data-proyecto-tech]");
  const linkCodigo = document.querySelector("[data-proyecto-link]");
  const linkDemo = document.querySelector("[data-proyecto-live]");
  const tabs = Array.from(document.querySelectorAll(".proyecto-tab"));
  const filtros = Array.from(document.querySelectorAll(".proyecto-filtro"));

  let currentIndex = 0;
  let currentFilter = "all";

  function translate(key) {
    if (window.i18next && window.i18next.isInitialized) {
      const value = window.i18next.t(key);
      if (value && value !== key) return value;
    }
    return null;
  }

  function mosaicMarkup(images, title) {
    const cellClass = "h-full w-full object-cover rounded-xl";
    if (images.length <= 1) {
      return `<div class="h-72 sm:h-80"><img src="${images[0]}" alt="${title}" class="${cellClass}" /></div>`;
    }
    if (images.length === 2) {
      return `<div class="grid grid-cols-2 gap-2 h-72 sm:h-80">${images
        .map((src) => `<img src="${src}" alt="${title}" class="${cellClass}" />`)
        .join("")}</div>`;
    }
    const [first, ...rest] = images;
    return `<div class="grid grid-cols-2 grid-rows-2 gap-2 h-72 sm:h-80">
      <img src="${first}" alt="${title}" class="row-span-2 ${cellClass}" />
      ${rest
        .slice(0, 2)
        .map((src) => `<img src="${src}" alt="${title}" class="${cellClass}" />`)
        .join("")}
    </div>`;
  }

  function render(index) {
    currentIndex = index;
    const project = projects[index];
    const title = translate(project.titleKey) || project.titleKey;
    const description = translate(project.descriptionKey) || "";

    panelFotos.style.opacity = "0";
    window.setTimeout(() => {
      panelFotos.innerHTML = mosaicMarkup(project.images, title);
      panelFotos.style.opacity = "1";
    }, 120);

    titulo.textContent = title;
    desc.textContent = description;

    privadoBadge.classList.toggle("hidden", !project.isPrivate);

    if (project.client) {
      clienteLine.textContent = `${translate("proyectos_cliente_label") || "Cliente"}: ${project.client}`;
      clienteLine.classList.remove("hidden");
    } else {
      clienteLine.classList.add("hidden");
    }

    techWrap.innerHTML = project.tech
      .map(
        (tech) =>
          `<span class="bg-gray-700 text-gray-300 px-3 py-1 rounded text-xs">${tech}</span>`
      )
      .join("");

    if (project.link) {
      linkCodigo.href = project.link;
      linkCodigo.classList.remove("hidden");
    } else {
      linkCodigo.classList.add("hidden");
    }

    if (project.live) {
      linkDemo.href = project.live;
      linkDemo.classList.remove("hidden");
    } else {
      linkDemo.classList.add("hidden");
    }

    tabs.forEach((tab, i) => {
      tab.setAttribute("aria-selected", i === index ? "true" : "false");
    });
  }

  function applyFilter(filter) {
    currentFilter = filter;
    filtros.forEach((btn) => {
      btn.setAttribute("aria-pressed", btn.dataset.filtro === filter ? "true" : "false");
    });

    let firstVisibleIndex = -1;
    tabs.forEach((tab) => {
      const index = Number(tab.dataset.index);
      const matches = filter === "all" || tab.dataset.categoria === filter;
      tab.classList.toggle("hidden", !matches);
      if (matches && firstVisibleIndex === -1) firstVisibleIndex = index;
    });

    const activeTabVisible = !tabs[currentIndex].classList.contains("hidden");
    if (!activeTabVisible && firstVisibleIndex !== -1) {
      render(firstVisibleIndex);
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => render(Number(tab.dataset.index)));
    tab.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      event.preventDefault();
      const visibleTabs = tabs.filter((t) => !t.classList.contains("hidden"));
      const pos = visibleTabs.indexOf(tab);
      if (pos === -1) return;
      const nextPos =
        event.key === "ArrowDown"
          ? (pos + 1) % visibleTabs.length
          : (pos - 1 + visibleTabs.length) % visibleTabs.length;
      const nextTab = visibleTabs[nextPos];
      nextTab.focus();
      render(Number(nextTab.dataset.index));
    });
  });

  filtros.forEach((btn) => {
    btn.addEventListener("click", () => applyFilter(btn.dataset.filtro));
  });

  window.addEventListener("languageChanged", () => render(currentIndex));

  render(0);
</script>
